# Copy to .env (never commit .env). Placeholders only. All keys are OPTIONAL: demo mode needs none.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=            # GOOGLE_API_KEY is also accepted

# Optional model overrides (defaults are suggestions only; check each provider's docs)
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=

DATA_DIR=./data
PRICING_FILE=./config/pricing.json     # optional; see config/pricing.example.json
APP_ACCESS_TOKEN=                      # set this if the server is reachable by anyone but you
ENABLE_COMMAND_EXECUTION=false         # true = run allow-listed npm/pytest commands on generated code (NOT a sandbox)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
